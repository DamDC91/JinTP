with "gnatcoll.gpr";
with "aunit.gpr";
with "../jintp.gpr";
with "config/jintp_tests_config.gpr";
project Jintp_Tests is

   Coverage := external ("JINTP_COVERAGE", "false");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Jintp_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("jintp_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Jintp_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Coverage is
         when "true" =>
            for Default_Switches ("Ada") use ("--coverage");
         when others =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Jintp_Tests;
